# Immutable, security-hardened Alpine base layer with verified October 2026 components
FROM alpine:3.24.2

# Install pinned core runtime dependencies
RUN apk add --no-cache \
    bash>=5.2 \
    python3>=3.12 \
    py3-pip \
    py3-yaml>=6.0 \
    jq=1.8.2-r0 \
    git>=2.45 \
    github-cli>=2.97 \
    docker-cli>=26.0 \
    curl \
    openssh-client

# Establish Python virtual environment isolation for Ansible toolchain
RUN git config --system --add safe.directory '*' && \
    python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir ansible-core==2.21.5 pyyaml==6.0.2 && \
    /opt/venv/bin/ansible-galaxy collection install community.docker:>=5.4.0

# Expose executable pathway
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /workspace
ENTRYPOINT ["/bin/bash", "-c"]
